# ScrapX — Apache configuration (shared hosting friendly)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS when the setting is enabled by the host (uncomment if desired)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Block dotfiles
    RewriteRule (^|/)\. - [F]

    # Everything that is not an existing file or directory goes to the front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Deny direct access to application internals
RedirectMatch 404 ^/(app|config|database|resources|storage|docs|tests)(/|$)
RedirectMatch 404 ^/config\.php$
RedirectMatch 404 ^/composer\.(json|lock)$

<FilesMatch "^(config\.php|\.env|version\.json\.bak)$">
    Require all denied
</FilesMatch>

# Basic hardening
Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# PHP limits (ignored silently if not permitted by the host)
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 24M
    php_value max_execution_time 300
    php_value memory_limit 256M
</IfModule>
