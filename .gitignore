# ScrapX — files that must never reach the repository
#
# config.php holds live database credentials and the per-installation app key.
# It is generated by /install and is a PROTECTED path the updater never touches.
/config.php
/.env

# Installation state
/storage/installed.lock

# Runtime data
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/backups/*
!/storage/backups/.gitkeep
/storage/tmp/*
!/storage/tmp/.gitkeep
/storage/framework/*
!/storage/framework/.gitkeep

# User uploads
/uploads/*
!/uploads/.gitkeep
!/uploads/*/
/uploads/*/*
!/uploads/*/.gitkeep

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.log
